# Provider 回退链顺序（逗号分隔，按优先级排列）
PROVIDER_CHAIN=groq,anthropic

# Provider API Keys
GROQ_API_KEY=gsk_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
# GEMINI_API_KEY=AIza_xxx

# BridgeAI 用户 Key（格式：key 或 key:月度预算USD）
# 示例：bridge-free-001:1.00 表示该 key 月度上限 $1
BRIDGE_API_KEYS=bridge-free-001:1.00,bridge-pro-001

PORT=8080
